#######################################################################
LOCATION = xic/src/oa
#######################################################################

XIC_VERSION = @XIC_VERSION@
DATE = @DATE@

CXX = @CXX@
CC = @CC@
CFLAGS = @OA_CFLAGS@
DEPEND_PROG = @DEPEND_PROGXX@ @OA_CFLAGS@ @NEEDINT64@
AR = @AR@
RANLIB = @RANLIB@
FILTER = @FILTER@
PIC_OPT = @PIC_OPT@
SOEXT = @SOEXT@
LSHFLAG = @LSHFLAG@
OA_INCLUDE = @OA_INCLUDE@
OA_LIBS = @OA_LIBS@
OSNAME = @OSNAME@

LIB_TARGET = oa.a
SHLIB_TARGET = oa.$(SOEXT)

BASE = ../../../xt_base
INCLUDE = -I. -I../../include -I$(BASE)/include -I$(OA_INCLUDE)

HFILES = \
  oa.h oa_alib.h oa_errlog.h oa_lib_observer.h oa_nametab.h oa_net.h \
  oa_prop.h oa_tech_observer.h oa_via.h
CCFILES = \
  oa.cc oa_alib.cc oa_errlog.cc oa_lib_observer.cc oa_library.cc \
  oa_load.cc oa_nametab.cc oa_net.cc oa_prop.cc oa_save.cc oa_tech.cc \
  oa_tech_observer.cc oa_via.cc
CCOBJS = $(CCFILES:.cc=.o)

DARGS = -DOSNAME="\"$(OSNAME)\""

SHLIB_TARGET: $(CCOBJS) Makefile
	@echo $(SHLIB_TARGET): linking
	@$(CXX) $(LSHFLAG) -o $(SHLIB_TARGET) $(CCOBJS) $(OA_LIBS)
	# FIXME Apple oddity, Apple only
ifeq ($(shell uname -s),Darwin)
	install_name_tool -change "../../lib/common/darwin_64/opt/liboaCommon.dylib" "@rpath/liboaCommon.dylib" oa.dylib
	install_name_tool -change "../../lib/base/darwin_64/opt/liboaBase.dylib" "@rpath/liboaBase.dylib" oa.dylib
	install_name_tool -change "../../lib/plugIn/darwin_64/opt/liboaPlugIn.dylib" "@rpath/liboaPlugIn.dylib" oa.dylib
	install_name_tool -change "../../lib/dm/darwin_64/opt/liboaDM.dylib" "@rpath/liboaDM.dylib" oa.dylib
	install_name_tool -change "../../lib/tech/darwin_64/opt/liboaTech.dylib" "@rpath/liboaTech.dylib" oa.dylib
	install_name_tool -change "../../lib/design/darwin_64/opt/liboaDesign.dylib" "@rpath/liboaDesign.dylib" oa.dylib
endif

$(LIB_TARGET): $(CCOBJS)
	@if [ -f $(LIB_TARGET) ]; then \
	    rm -f $(LIB_TARGET); \
	fi
	$(AR) cr $(LIB_TARGET) $(CCOBJS)
	$(RANLIB) $(LIB_TARGET)

.cc.o:
	$(CXX) $(CFLAGS) $(DARGS) $(PIC_OPT) $(INCLUDE) -c $*.cc

depend:
	@echo depending in $(LOCATION)
	@if [ x$(DEPEND_DONE) = x ]; then \
	    echo DEPEND_DONE = 1 >> Makefile; \
	    $(DEPEND_PROG) $(INCLUDE) $(CCFILES) $(FILTER) >> Makefile; \
	fi

clean:
	-@rm -f $(CCOBJS) $(LIB_TARGET) $(SHLIB_TARGET)

distclean: clean
	-@rm -f Makefile

#######################################################################

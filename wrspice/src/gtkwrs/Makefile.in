#######################################################################
LOCATION = wrspice/src/gtkwrs
#######################################################################

WRSPICE_VERSION = @WRSPICE_VERSION@
DATE = @DATE@

XCFLAGS = -DGTK_DISABLE_SINGLE_INCLUDES -DGDK_DISABLE_DEPRECATED  \
-DGTK_DISABLE_DEPRECATED  -DGSEAL_ENABLE 

CXX = @CXX@
CC = @CC@
CFLAGS = @CFLAGSG@ @GTKCFLAGS@ @UFLAGS@ @WITH_X11@ -DWRSPICE -DRUN_GTK
DEPEND_PROG = @DEPEND_PROGXX@ @CFLAGSG@ @GTKCFLAGS@ -DWRSPICE -DRUN_GTK
WINDRES = @WINDRES@
AR = @AR@
LD = @LD@
RANLIB = @RANLIB@
FILTER = @FILTER@
USEMOZY = @USEMOZY@
GTKINC = @GTKINC@
RESOURCE = @RESOURCE@

LIB_TARGET = gtkwrs.a

BASE = ../../../xt_base
INCLUDE = -I. -I../../include -I$(BASE)/include

HFILES = gtktoolb.h
CCFILES = graph.cc gtkcmds.cc gtkcolor.cc gtkdebug.cc gtkfte.cc \
  gtkpldef.cc gtkplot.cc gtkshell.cc gtksim.cc gtktoolb.cc
CCOBJS = $(CCFILES:.cc=.o) $(RESOURCE)

$(LIB_TARGET): cptest $(CCOBJS)
	@if [ -f $(LIB_TARGET) ]; then \
	    rm -f $(LIB_TARGET); \
	fi
	$(AR) cr $(LIB_TARGET) $(CCOBJS)
	$(RANLIB) $(LIB_TARGET)

ifeq ($(USEMOZY), yes)
MOZY = ../../../mozy
MOZYINC = -I$(MOZY)/include
MOBJS = gtkcmds.o gtkcolor.o gtkfte.o gtktoolb.o

$(MOBJS):
	$(CXX) $(CFLAGS) $(INCLUDE) $(MOZYINC) $(GTKINC) -c $*.cc
endif

.cc.o:
	$(CXX) $(CFLAGS) $(INCLUDE) $(GTKINC) -c $*.cc

graph.cc: ../plot/graph.cc
	cp -f ../plot/graph.cc .

depend:: graph.cc
	@echo depending in $(LOCATION)
	@if [ x$(DEPEND_DONE) = x ]; then \
	    echo DEPEND_DONE = 1 >> Makefile; \
	    $(DEPEND_PROG) $(INCLUDE) $(MOZYINC) $(GTKINC) \
  $(CCFILES) $(FILTER) >> Makefile; \
	fi

clean:: 
	-@rm -f $(CCOBJS) $(LIB_TARGET) graph.cc

distclean: clean
	-@rm -f Makefile

resource.o: ../msw/resource.cc ../msw/wrs.rc
	vers=$(WRSPICE_VERSION); \
	IFS="$$IFS."; \
	set $$vers; \
	$(WINDRES) -DWRSPICE_RESOURCE -DWRS_BIN_VERSION="0,$$1,$$2,$$3" \
 -DWRS_FILE_VERSION=\\\"$$1.$$2.$$3\\\" \
 -DWRS_PROG_VERSION=\\\"Xic-$$1.$$2.$$3\\\"  ../msw/wrs.rc resource_temp.o
	$(CC) -c -o restmp.o ../msw/resource.cc
	$(LD) -r -o resource.o resource_temp.o restmp.o
	rm -f resource_temp.o restmp.o

# Make sure that the copies are the same as the source, avoid local
# updates that won't propagate!
cptest: graph.cc
	@for a in graph.cc; do \
	    set -- $$(/usr/bin/sum ../plot/$$a); s1=$$1; \
	    set -- $$(/usr/bin/sum $$a); s2=$$1; \
	    if [ "$$s1" != "$$s2" ]; then \
	        echo ; \
	        echo  "ERROR!!! $$a differs in wrspice/src/plot, FIXME"; \
	        echo ; \
	        exit 1; \
	    fi; \
	done

#######################################################################

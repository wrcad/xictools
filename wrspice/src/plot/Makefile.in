#######################################################################
LOCATION = wrspice/src/plot
#######################################################################

WRSPICE_VERSION = @WRSPICE_VERSION@
DATE = @DATE@

CXX = @CXX@
CC = @CC@
CFLAGS = @CFLAGSG@ @UFLAGS@ -DWRSPICE
QTPREF = @QTPREF@
GTKPREF = @GTKPREF@
DEPEND_PROG = @DEPEND_PROGXX@ @CFLAGSG@ -DWRSPICE
AR = @AR@
RANLIB = @RANLIB@
FILTER = @FILTER@

# Compile graph.cc here only if no toolkit.  The file is otherwise
# copied to toolkit-specific directories for compilation.
ifeq ($(QTPREF)$(GTKPREF),)
    GRAPH = graph.cc
endif

LIB_TARGET = plot.a

BASE = ../../../xt_base
INCLUDE = -I../../include -I$(BASE)/include

HFILES =
CCFILES = asciplot.cc clip.cc doplot.cc fourier.cc $(GRAPH) graphdb.cc \
  grid.cc grsetup.cc hardcopy.cc mplot.cc plotutil.cc xgplot.cc
CCOBJS = $(CCFILES:.cc=.o)

$(LIB_TARGET): $(CCOBJS)
	@if [ -f $(LIB_TARGET) ]; then \
	    rm -f $(LIB_TARGET); \
	fi
	$(AR) cr $(LIB_TARGET) $(CCOBJS)
	$(RANLIB) $(LIB_TARGET)

.cc.o:
	$(CXX) $(CFLAGS) $(INCLUDE) -c $*.cc

depend:
	@echo depending in $(LOCATION)
	@if [ x$(DEPEND_DONE) = x ]; then \
	    echo DEPEND_DONE = 1 >> Makefile; \
	    $(DEPEND_PROG) $(INCLUDE) $(CCFILES) $(FILTER) >> Makefile; \
	fi

clean:
	-@rm -f $(CCOBJS) $(LIB_TARGET)

distclean: clean
	-@rm -f Makefile

#######################################################################

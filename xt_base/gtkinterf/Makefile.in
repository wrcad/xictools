#######################################################################
LOCATION = xt_base/gtkinterf
#######################################################################

DATE = @DATE@

XCFLAGS = -DGTK_DISABLE_SINGLE_INCLUDES -DGDK_DISABLE_DEPRECATED  \
-DGTK_DISABLE_DEPRECATED  -DGSEAL_ENABLE 

CXX = @CXX@
CC = @CC@
CFLAGS = @CFLAGSG@ @GTKCFLAGS@ @UFLAGS@ @WITH_X11@ -DRUN_GTK
DEPEND_PROG = @DEPEND_PROGXX@ @CFLAGSG@ @GTKCFLAGS@ -DRUN_PGTK
AR = @AR@
RANLIB = @RANLIB@
FILTER = @FILTER@

INCLUDE = -I../include -I../include/ginterf -I../include/gtkinterf \
  -I../../mozy/include @GTKINC@

LIB_TARGET = ../lib/gtkinterf.a

HFILES =
CCFILES = \
  gtkdraw.cc gtkedit.cc gtkfile.cc gtkfont.cc gtkhcopy.cc gtkinterf.cc \
  gtklist.cc gtkmcol.cc gtkpfiles.cc gtksearch.cc gtkspinbtn.cc \
  gtkutil.cc hcimlib.cc ndkcursor.cc ndkdrawable.cc ndkgc.cc ndkimage.cc \
  ndkpixmap.cc

CCOBJS = $(CCFILES:.cc=.o)

$(LIB_TARGET): cptest $(CCOBJS)
	-@rm -f $(LIB_TARGET); \
	$(AR) cr $(LIB_TARGET) $(CCOBJS)
	$(RANLIB) $(LIB_TARGET)

.cc.o:
	$(CXX) -c $(CFLAGS) $(INCLUDE) -o $@ $<

hcimlib.cc: ../ginterf/hcimlib.cc
	cp -f ../ginterf/hcimlib.cc .

clean:
	-@rm -f $(CCOBJS) $(LIB_TARGET) hcimlib.cc

distclean: clean
	-@rm -f Makefile

depend: hcimlib.cc
	@echo depending in $(LOCATION)
	@if [ x$(DEPEND_DONE) = x ]; then \
	    echo DEPEND_DONE = 1 >> Makefile; \
	    $(DEPEND_PROG) $(INCLUDE) $(CCFILES) $(FILTER) >> Makefile; \
	fi

install:

uninstall:

# Make sure that the copies are the same as the source, avoid local
# updates that won't propagate!
cptest: hcimlib.cc
	@for a in hcimlib.cc; do \
	    set -- $$(/usr/bin/sum ../ginterf/$$a); s1=$$1; \
	    set -- $$(/usr/bin/sum $$a); s2=$$1; \
	    if [ "$$s1" != "$$s2" ]; then \
	        echo ; \
	        echo  "ERROR!!! $$a differs in xt_base/ginterf, FIXME"; \
	        echo ; \
	        exit 1; \
	    fi; \
	done

#######################################################################

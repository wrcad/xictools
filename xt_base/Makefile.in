#######################################################################
LOCATION = xt_base
#######################################################################

DATE = @DATE@
MALLOC = @MALLOC@
REGEX = @REGEX@
QTPREF = @QTPREF@
GTKPREF = @GTKPREF@
MSW = @MSW@

ifdef MALLOC
MALLOC_DIR = malloc
endif

ifdef REGEX
REGEX_DIR = regex
endif

ifdef QTPREF
QTPREF_DIR = $(QTPREF)interf
endif
ifdef GTKPREF
GTKPREF_DIR = $(GTKPREF)interf
endif

ifdef MSW
MSW_DIR = msw
endif

SUBDIRS = \
  miscutil \
  ginterf \
  util \
  $(QTPREF_DIR) \
  $(GTKPREF_DIR) \
  $(MSW_DIR) \
  $(MALLOC_DIR) \
  $(REGEX_DIR)

all:
	@if [ ! -d lib ]; then \
	    mkdir lib; \
	fi
	@for a in $(SUBDIRS); do \
	    if [ -d $$a ]; then \
	        $(MAKE) -C $$a ; \
	    fi; \
	done

depend clean:
	-@for a in $(SUBDIRS); do \
	    if [ -d $$a ]; then \
	        $(MAKE) -C $$a $@; \
	    fi; \
	done

distclean:
	-@for a in $(SUBDIRS); do \
	    if [ -d $$a -a -e $$a/Makefile ]; then \
	        echo "  $$a"; \
	        $(MAKE) -C $$a $@; \
	    fi; \
	done
	-@mv -f packages/pkgfiles/README packages
	-@rm -rf packages/pkgfiles
	-@mkdir packages/pkgfiles
	-@mv packages/README packages/pkgfiles
	-@rm -f config.cache config.log config.status configure Makefile
	-@rm -rf lib autom4te.cache
	-@rm -f include/config.h include/grconfig.h

install uninstall package:


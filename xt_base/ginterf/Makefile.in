#######################################################################
LOCATION = xt_base/ginterf
#######################################################################

DATE = @DATE@

CXX = @CXX@
CC = @CC@
CFLAGS = @CFLAGSG@ @UFLAGS@ @WITH_X11@
QTPREF = @QTPREF@
GTKPREF = @GTKPREF@
DEPEND_PROG = @DEPEND_PROGXX@ @CFLAGSG@
AR = @AR@
RANLIB = @RANLIB@
FILTER = @FILTER@
MSW = @MSW@
USEIMSAVE = @USEIMSAVE@

INCLUDE = -I../include -I../include/ginterf @IMG_INCLUDES@

LIB_TARGET = ../lib/ginterf.a

ifdef USEIMSAVE
IMSAVE = imsave
HCIMLIB = hcimlib.cc
endif

ifdef MSW
MSWDRAW = mswdraw.cc
MSWHCDEV = hcmswpdev.cc
endif

HCFILES = \
  $(HCIMLIB) hchpgl.cc hcpcl.cc hcpsbc.cc hcpsbm.cc hcpslindrw.cc hcxfig.cc \
  $(MSWHCDEV)

HFILES =
CCFILES = \
  colorname.cc graphics.cc grfont.cc grimage.cc grlinedb.cc \
  grvecfont.cc pixtab.cc polydecomp.cc psencode.cc raster.cc rgbmap.cc \
  rgbzimg.cc shmctl.cc x11draw.cc $(HCFILES) $(MSWDRAW)

CCOBJS = $(CCFILES:.cc=.o)

$(LIB_TARGET): $(IMSAVE) $(CCOBJS)
	-@rm -f $(LIB_TARGET); \
	$(AR) cr $(LIB_TARGET) $(CCOBJS)
	$(RANLIB) $(LIB_TARGET)
	-@if [ -n "$(IMSAVE)" ]; then \
	    $(MAKE) -C $(IMSAVE); \
	fi

.cc.o:
	$(CXX) $(CFLAGS) $(INCLUDE) -c $*.cc

clean:
	-@rm -f $(CCOBJS) $(LIB_TARGET)
	-@if [ -n "$(IMSAVE)" ]; then \
	    $(MAKE) -C $(IMSAVE) clean; \
	fi

distclean: clean
	-@rm -f Makefile
	-@if [ -n "$(IMSAVE)" ]; then \
	    $(MAKE) -C $(IMSAVE) distclean; \
	fi

depend:
	@echo depending in $(LOCATION)
	@if [ x$(DEPEND_DONE) = x ]; then \
	    echo DEPEND_DONE = 1 >> Makefile; \
	    $(DEPEND_PROG) $(INCLUDE) $(CCFILES) \
  $(FILTER) >> Makefile; \
	fi
	@if [ -n "$(IMSAVE)" ]; then \
	    $(MAKE) -C $(IMSAVE) depend; \
	fi

#######################################################################

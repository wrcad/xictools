#######################################################################
LOCATION = mozy
#######################################################################

DATE = @DATE@

prefix = @prefix@
itopok = @itopok@
CXX = @CXX@
CC = @CC@
LINKCC = @LINKCC@
CFLAGS = @CFLAGSG@ @DYNAMIC_LIBS@ @UFLAGS@ -DXICTOOLS
LFLAGS = @LFLAGS@ @UFLAGS@
MSLIBS = @MSLIBS@
LIBS = @LIBS@ @EXTRALIBS@
OSNAME = @OSNAME@
ARCH = @ARCH@
QTPREF = @QTPREF@
QTPKG = @QTPKG@
QTLIBS = @QTLIBS@
QTLFLAGS = @QTLFLAGS@
GTKPREF = @GTKPREF@
GTKPKG = @GTKPKG@
GTKLIBS = @GTKLIBS@
GTKLFLAGS = @GTKLFLAGS@
DEPEND_PROG = @DEPEND_PROGXX@ @CFLAGSG@ @DYNAMIC_LIBS@ -DXICTOOLS
RANLIB = @RANLIB@
STDCLIB = @STDCLIB@
INSTALL = @INSTALL@
EXESUFFIX = @EXESUFFIX@
FILTER = @FILTER@
REGEX = @REGEX@
MOZYRES = @MOZYRES@
XEDRES = @XEDRES@
TOOLROOT = @TOOLROOT@
WINPTHREADFIX = @WINPTHREADFIX@

BASE = ../xt_base
INCLUDE = -Iinclude -I$(BASE)/include

MOZY_VERSION := `./release.sh`

LOCAL_LIBS = \
  lib/htm.a \
  lib/help.a \
  lib/htm.a \
  lib/help.a \
  lib/httpget.a \
  lib/imsave.a \
  $(BASE)/lib/ginterf.a \
  $(BASE)/lib/miscutil.a \
  $(REGEX)

ifdef QTPREF
libQTmozy = lib/$(QTPREF)mozy.a
libQTinterf = $(BASE)/lib/$(QTPREF)interf.a
srcQTmozy = src/$(QTPREF)mozy
binQTmozy = bin/$(QTPKG)/mozy
binQTxeditor = bin/$(QTPKG)/xeditor
QT_LOCAL_LIBS = $(LOCAL_LIBS) $(libQTmozy) $(libQTinterf)
#QT_LOCAL_LIBS = \
#  lib/htm.a \
#  lib/help.a \
#  $(libQTmozy) \
#  lib/htm.a \
#  lib/help.a \
#  lib/httpget.a \
#  lib/imsave.a \
#  $(libQTinterf) \
#  $(BASE)/lib/ginterf.a \
#  $(BASE)/lib/miscutil.a \
#  $(REGEX)
endif

ifdef GTKPREF
libGTKmozy = lib/$(GTKPREF)mozy.a
libGTKinterf = $(BASE)/lib/$(GTKPREF)interf.a
srcGTKmozy = src/$(GTKPREF)mozy
binGTKmozy = bin/$(GTKPKG)/mozy
binGTKxeditor = bin/$(GTKPKG)/xeditor
GTK_LOCAL_LIBS = $(LOCAL_LIBS) $(libGTKmozy) $(libGTKinterf)
#GTK_LOCAL_LIBS = \
#  lib/htm.a \
#  lib/help.a \
#  $(libGTKmozy) \
#  lib/htm.a \
#  lib/help.a \
#  lib/httpget.a \
#  lib/imsave.a \
#  $(libGTKinterf) \
#  $(BASE)/lib/ginterf.a \
#  $(BASE)/lib/miscutil.a \
#  $(REGEX)
endif


INSTALL_BIN    = $(INSTALL) -s -c -m 0755
INSTALL_SCRIPT = $(INSTALL) -c -m 0755
INSTALL_LIB    = $(INSTALL) -c -m 0644
INSTALL_LIB_RO = $(INSTALL) -c -m 0444

SUBDIRS = $(srcQTmozy) $(srcGTKmozy) src/help src/htm src/httpget src/imsave

TARGETS = mdir $(binQTmozy) $(binQTxeditor) $(binGTKmozy) $(binGTKxeditor) \
  bin/hlp2latex bin/hlpsrv bin/hlp2html bin/httpget

all:  $(TARGETS)

mdir::
	@if [ -n "$(QTPKG)" ]; then \
	    if [ ! -d bin/$(QTPKG) ]; then \
	        mkdir bin/$(QTPKG); \
	    fi; \
	fi    
	@if [ -n "$(GTKPKG)" ]; then \
	    if [ ! -d bin/$(GTKPKG) ]; then \
	        mkdir bin/$(GTKPKG); \
	    fi; \
	fi    

ifdef QTPKG
bin/$(QTPKG)/mozy: bin/mozy.o $(QT_LOCAL_LIBS) $(MOZYRES)
	@echo $@: dynamic link mozy
	@$(LINKCC) -o bin/$(QTPKG)/mozy $(QTLFLAGS) $(LFLAGS) \
  bin/mozy.o $(QT_LOCAL_LIBS) $(LIBS) $(QTLIBS) $(MOZYRES) $(STDCLIB)

bin/$(QTPKG)/xeditor: bin/xeditor.o $(QT_LOCAL_LIBS) $(XEDRES)
	@echo $@: dynamic link
	@$(LINKCC) -o bin/$(QTPKG)/xeditor $(QTLFLAGS) $(LFLAGS) \
  bin/xeditor.o $(QT_LOCAL_LIBS) $(LIBS) $(QTLIBS) $(XEDRES) $(STDCLIB)
endif

ifdef GTKPKG
bin/$(GTKPKG)/mozy: bin/mozy.o $(GTK_LOCAL_LIBS) $(MOZYRES)
	@echo $@: dynamic link mozy
	@$(LINKCC) -o bin/$(GTKPKG)/mozy $(GTKLFLAGS) $(LFLAGS) \
  bin/mozy.o $(GTK_LOCAL_LIBS) $(LIBS) $(GTKLIBS) $(MOZYRES) $(STDCLIB)

bin/$(GTKPKG)/xeditor: bin/xeditor.o $(GTK_LOCAL_LIBS) $(XEDRES)
	@echo $@: dynamic link
	@$(LINKCC) -o bin/$(GTKPKG)/xeditor $(GTKLFLAGS) $(LFLAGS) \
  bin/xeditor.o $(GTK_LOCAL_LIBS) $(LIBS) $(GTKLIBS) $(XEDRES) $(STDCLIB)
endif

bin/hlp2latex: bin/hlp2latex.o lib/help.a $(BASE)/lib/ginterf.a \
  $(BASE)/lib/miscutil.a
	@$(LINKCC) -o bin/hlp2latex $(LFLAGS) bin/hlp2latex.o \
  src/help/help_read.o $(BASE)/ginterf/graphics.o \
  $(BASE)/lib/miscutil.a $(REGEX) $(MSLIBS) $(STDCLIB) $(WINPTHREADFIX)

bin/hlpsrv: bin/hlpsrv.o lib/help.a $(BASE)/lib/ginterf.a \
  $(BASE)/lib/miscutil.a
	@$(LINKCC) -o bin/hlpsrv $(LFLAGS) bin/hlpsrv.o \
  src/help/help_read.o $(BASE)/ginterf/graphics.o \
  $(BASE)/lib/miscutil.a $(REGEX) $(MSLIBS) $(STDCLIB) $(WINPTHREADFIX)

bin/hlp2html: bin/hlp2html.o lib/help.a $(BASE)/lib/ginterf.a \
  $(BASE)/lib/miscutil.a Makefile
	@$(LINKCC) -o bin/hlp2html $(LFLAGS) bin/hlp2html.o \
  src/help/help_read.o $(BASE)/ginterf/graphics.o \
  $(BASE)/lib/miscutil.a $(REGEX) $(MSLIBS) $(STDCLIB) $(WINPTHREADFIX)

bin/httpget: bin/httpget.o $(LOCAL_LIBS)
	@echo $@: dynamic link httpget
	@$(LINKCC) -o bin/httpget $(LFLAGS) bin/httpget.o lib/httpget.a \
  $(LOCAL_LIBS) $(STDCLIB)

bin/httpget.o: bin/httpget.cc
	$(CXX) $(CFLAGS) $(INCLUDE) -DNO_GRAPHICS -c $*.cc -o $*.o

bin/mozy.o: bin/mozy.cc
	$(CXX) $(CFLAGS) -DPREFIX=\"$(prefix)\" \
  -DVERSION_STR=\"$(MOZY_VERSION)\" -DOSNAME_STR=\"$(OSNAME)\" \
  -DARCH_STR=\"$(ARCH)\" $(INCLUDE) -c bin/mozy.cc -o bin/mozy.o

bin/xeditor.o: bin/xeditor.cc
	$(CXX) $(CFLAGS) -DPREFIX=\"$(prefix)\" \
  -DVERSION_STR=\"$(MOZY_VERSION)\" -DOSNAME_STR=\"$(OSNAME)\" \
  -DARCH_STR=\"$(ARCH)\" $(INCLUDE) -c bin/xeditor.cc -o bin/xeditor.o

.cc.o:
	$(CXX) $(CFLAGS) $(INCLUDE) -c $*.cc -o $*.o

#######################################################################
####### Recursively generate libraries ################################

lib/help.a::
	$(MAKE) -C src/help

lib/htm.a::
	$(MAKE) -C src/htm

lib/httpget.a::
	$(MAKE) -C src/httpget

lib/imsave.a::
	$(MAKE) -C src/imsave

$(BASE)/lib/ginterf.a::
	$(MAKE) -C $(BASE)/ginterf

ifdef QTPREF
lib/$(QTPREF)mozy.a::
	$(MAKE) -C src/$(QTPREF)mozy

$(BASE)/lib/$(QTPREF)interf.a::
	$(MAKE) -C $(BASE)/$(QTPREF)interf
endif

ifdef GTKPREF
lib/$(GTKPREF)mozy.a::
	$(MAKE) -C src/$(GTKPREF)mozy

$(BASE)/lib/$(GTKPREF)interf.a::
	$(MAKE) -C $(BASE)/$(GTKPREF)interf
endif

$(BASE)/lib/miscutil.a::
	$(MAKE) -C $(BASE)/miscutil

$(BASE)/lib/libregex.a::
	$(MAKE) -C $(BASE)/regex

foo $(MOZYRES) $(XEDRES):
	$(MAKE) -C $(@D) $(@F)

#######################################################################
####### Dependencies in this directory ################################

CCFILES = bin/mozy.cc bin/xeditor.cc bin/hlp2latex.cc bin/hlpsrv.cc \
  bin/hlp2html.cc bin/httpget.cc

depend::
	@echo depending in $(LOCATION)
	@if [ x$(DEPEND_DONE) = x ]; then \
	    echo DEPEND_DONE = 1 >> Makefile; \
	    for a in $(CCFILES); do \
	      $(DEPEND_PROG) $(INCLUDE) $$a -MT bin/`basename $$a .cc`.o \
  $(FILTER) >> Makefile; \
	    done; \
	fi
	@for a in $(SUBDIRS); do \
	  $(MAKE) -C $$a depend; \
	done

#######################################################################
####### Clean up ######################################################

eclean::
	-@for a in $(TARGETS); do \
	    if [ -d $$a ]; then \
	        rm -rf $$a; \
	    elif [ -f $$a$(EXESUFFIX) ]; then \
	        rm -rf $$a$(EXESUFFIX); \
	    fi; \
	done

clean:: eclean
	-@for a in $(SUBDIRS); do \
	    if [ -d $$a -a -f $$a/Makefile ]; then \
	        $(MAKE) -C $$a $@; \
	    fi; \
	done
	-@rm -f bin/*.o

distclean:: eclean
	-@for a in $(SUBDIRS) packages; do \
	    if [ -d $$a -a -f $$a/Makefile ]; then \
	        echo "  $$a"; \
	        $(MAKE) -C $$a $@; \
	    fi; \
	done
	-@rm -f bin/*.o Makefile

#######################################################################
####### Installation ##################################################

INSTALL_PREFIX ?= $(prefix)
destn = $(INSTALL_PREFIX)/$(TOOLROOT)/mozy
dst_bin = $(INSTALL_PREFIX)/$(TOOLROOT)/mozy/bin
toolbin = $(INSTALL_PREFIX)/$(TOOLROOT)/bin

install: install_test install_force clean_links install_links

install_force: uninstall_clean install_bin install_startup install_help

install_bin: $(dst_bin)
install_startup: $(destn)/startup
install_help: $(destn)/help

install_test::
	@if [ $(INSTALL_PREFIX) = $(prefix) ]; then \
	    if [ $(itopok) != yes ]; then \
	        echo "No!  Use pagkage to install!"; \
	        exit 1; \
	    fi; \
	fi

# In order to use the Windows mklink command, user must be running with
# Admin privileges, or Developer Mode must be on.  Set this from
# Settings/Update & Security/For Developers

install_links::
	@$(BASE)/util/mkdirpth $(toolbin)
	@if [ -n "$(EXESUFFIX)" ]; then \
	    $(BASE)/util/make_link $(toolbin)/hlp2latex$(EXESUFFIX) \
 $(dst_bin)/hlp2latex$(EXESUFFIX); \
	    $(BASE)/util/make_link $(toolbin)/hlpsrv$(EXESUFFIX) \
 $(dst_bin)/hlpsrv$(EXESUFFIX); \
	    $(BASE)/util/make_link $(toolbin)/hlp2html$(EXESUFFIX) \
 $(dst_bin)/hlp2html$(EXESUFFIX); \
	    $(BASE)/util/make_link $(toolbin)/httpget$(EXESUFFIX) \
 $(dst_bin)/httpget$(EXESUFFIX); \
	    cp -f $(dst_bin)/mozy.bat $(toolbin); \
	    cp -f $(dst_bin)/xeditor.bat $(toolbin); \
	else \
	    ln -s $(dst_bin)/hlp2latex $(toolbin)/hlp2latex; \
	    ln -s $(dst_bin)/hlpsrv $(toolbin)/hlpsrv; \
	    ln -s $(dst_bin)/hlp2html $(toolbin)/hlp2html; \
	    ln -s $(dst_bin)/httpget $(toolbin)/httpget; \
	fi
	cp -f $(dst_bin)/mozy.sh $(toolbin)/mozy
	chmod 755 $(toolbin)/mozy
	cp -f $(dst_bin)/xeditor.sh $(toolbin)/xeditor
	chmod 755 $(toolbin)/xeditor

clean_links::
	-@rm -f $(toolbin)/hlp2latex$(EXESUFFIX)
	-@rm -f $(toolbin)/hlpsrv$(EXESUFFIX)
	-@rm -f $(toolbin)/hlp2html$(EXESUFFIX)
	-@rm -f $(toolbin)/httpget$(EXESUFFIX)
	-@rm -f $(toolbin)/mozy
	-@rm -f $(toolbin)/xeditor
	-@if [ -n "$(EXESUFFIX)" ]; then \
	    rm -f $(toolbin)/mozy.bat; \
	    rm -f $(toolbin)/xeditor.bat; \
	fi    

$(dst_bin)::
	@$(BASE)/util/mkdirpth $@
	$(INSTALL_BIN) bin/hlp2latex$(EXESUFFIX) $@
	$(INSTALL_BIN) bin/hlpsrv$(EXESUFFIX) $@
	$(INSTALL_BIN) bin/hlp2html$(EXESUFFIX) $@
	$(INSTALL_BIN) bin/httpget$(EXESUFFIX) $@
	$(INSTALL_SCRIPT) bin/mozy.sh $@
	$(INSTALL_SCRIPT) bin/xeditor.sh $@
	@if [ -n "$(EXESUFFIX)" ]; then \
	    cp -f $(BASE)/util/program.bat $@/mozy.bat; \
	    cp -f $(BASE)/util/program.bat $@/xeditor.bat; \
	fi    
	@if [ -d bin/GTK2 ]; then \
	    mkdir $@/GTK2; \
	    $(INSTALL_BIN) bin/GTK2/mozy$(EXESUFFIX) $@/GTK2; \
	    $(INSTALL_BIN) bin/GTK2/xeditor$(EXESUFFIX) $@/GTK2; \
	fi
	@if [ -d bin/QT6 ]; then \
	    mkdir $@/QT6; \
	    $(INSTALL_BIN) bin/QT6/mozy$(EXESUFFIX) $@/QT6; \
	    $(INSTALL_BIN) bin/QT6/xeditor$(EXESUFFIX) $@/QT6; \
	elif [ -d bin/QT5 ]; then \
	    mkdir $@/QT5; \
	    $(INSTALL_BIN) bin/QT5/mozy$(EXESUFFIX) $@/QT5; \
	    $(INSTALL_BIN) bin/QT5/xeditor$(EXESUFFIX) $@/QT5; \
	fi

$(destn)/startup::
	@$(BASE)/util/mkdirpth $@
	startup=`packages/util/mozy_files startup`; \
	for a in $$startup; do \
	    $(INSTALL_LIB) startup/$$a $@; \
	done

$(destn)/help::
	if [ -f help/Makefile ]; then \
	    $(MAKE) -C help ; \
	fi
	@$(BASE)/util/mkdirpth $@
	help=`packages/util/mozy_files help`; \
	for a in $$help; do \
	    $(INSTALL_LIB) help/$$a $@; \
	done
	@$(BASE)/util/mkdirpth $@/screenshots
	ss=`packages/util/mozy_files help_ss`; \
	for a in $$ss; do \
	    $(INSTALL_LIB) help/screenshots/$$a $@/screenshots; \
	done

uninstall: uninstall_test uninstall_clean

uninstall_test::
	@if [ $(INSTALL_PREFIX) = $(prefix) ]; then \
	    if [ $(itopok) != yes ]; then \
	echo "No!  Use operating system or wr_uninstall script to uninstall!"; \
	        exit 1; \
	    fi; \
	fi

uninstall_clean:: clean_links
	-@rm -rf $(destn)

package::
	$(MAKE)
	-rm -rf packages/root
	mkdir packages/root
	$(MAKE) INSTALL_PREFIX=packages/root$(prefix) install_force
	$(MAKE) -C packages package

#######################################################################
